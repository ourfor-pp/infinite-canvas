[Unit]
Description=Infinite Canvas Media Executor
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/infinite-canvas/media-executor
EnvironmentFile=/etc/infinite-canvas/media-executor.env
ExecStart=/opt/infinite-canvas/media-executor/.venv/bin/infinite-media-executor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
