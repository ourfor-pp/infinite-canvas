[Unit]
Description=Infinite Canvas ACE-Step Runtime Adapter
After=network.target infinite-ace-step-engine.service
Requires=infinite-ace-step-engine.service

[Service]
WorkingDirectory=/opt/infinite-canvas/media-executor/runtimes/ace_step
EnvironmentFile=/etc/infinite-canvas/media-executor.env
ExecStart=/opt/infinite-canvas/media-executor/runtimes/ace_step/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8303
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
