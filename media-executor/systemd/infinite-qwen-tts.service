[Unit]
Description=Infinite Canvas Qwen3 TTS Runtime
After=network.target

[Service]
WorkingDirectory=/opt/infinite-canvas/media-executor/runtimes/qwen_tts
EnvironmentFile=/etc/infinite-canvas/media-executor.env
ExecStart=/opt/infinite-canvas/media-executor/runtimes/qwen_tts/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8301
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
