[Unit]
Description=Infinite Canvas MOSS SoundEffect Runtime
After=network.target

[Service]
WorkingDirectory=/opt/infinite-canvas/media-executor/runtimes/moss_sfx
EnvironmentFile=/etc/infinite-canvas/media-executor.env
ExecStart=/opt/infinite-canvas/media-executor/runtimes/moss_sfx/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8302
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
