MEDIA_EXECUTOR_HOST=0.0.0.0
MEDIA_EXECUTOR_PORT=8290
MEDIA_EXECUTOR_TOKEN=replace-with-a-long-random-token
MEDIA_EXECUTOR_DATA_DIR=/var/lib/infinite-media-executor
MEDIA_EXECUTOR_TEMP_FILE_TTL_SECONDS=86400
MEDIA_MODEL_ROOT=/data/sas/models
MEDIA_MODEL_SSD_ROOT=/home/cec/.local/share/infinite-media-executor/models
ACESTEP_CHECKPOINTS_DIR=/data/sas/models/ACE-Step1.5
COMFYUI_URL=http://127.0.0.1:8189
ACE_STEP_INTERNAL_URL=http://127.0.0.1:8001
ACE_STEP_ENABLED=0
STABLE_AUDIO_3_LICENSE_ACCEPTED=0
ACESTEP_CONFIG_PATH=acestep-v15-xl-sft
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B
ACESTEP_INIT_LLM=true
ACESTEP_NO_INIT=true
ACESTEP_DOWNLOAD_SOURCE=modelscope
ACESTEP_USE_FLASH_ATTENTION=false
ACESTEP_OFFLOAD_TO_CPU=true
ACESTEP_OFFLOAD_DIT_TO_CPU=true
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Native workers use private Unix sockets in the executor data directory.
# Explicit external engine units only; replace ComfyUI with the audited host unit.
MEDIA_EXECUTOR_COMFY_UNITS=system:comfyui-h3.service
MEDIA_EXECUTOR_ACE_UNITS=user:infinite-ace-step-engine.service
# Set to the verified model + runtime + dependency fingerprint before enabling reuse.
MEDIA_EXECUTOR_COMFY_REVISION=
MEDIA_EXECUTOR_QWEN_REVISION=
MEDIA_EXECUTOR_MOSS_REVISION=
MEDIA_EXECUTOR_ACE_REVISION=
MEDIA_EXECUTOR_ASR_REVISION=
MEDIA_EXECUTOR_VOX_REVISION=
MEDIA_EXECUTOR_INDEX_REVISION=
# Enable only after verified weights and a real worker inference succeed.
INDEX_TTS_ENABLED=0
