[Unit]
Description=Infinite Canvas Stable Audio 3 Runtime
After=network.target

[Service]
WorkingDirectory=/opt/infinite-canvas/media-executor/runtimes/stable_audio
EnvironmentFile=/etc/infinite-canvas/media-executor.env
ExecStart=/opt/infinite-canvas/media-executor/runtimes/stable_audio/.venv/bin/python app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
